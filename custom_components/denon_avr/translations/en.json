  "issues": {
    "speaker_layout_changed": {
      "title": "Speaker layout changed other choices",
      "description": "Applying the speaker layout also changed layout positions {positions}. The receiver does not put these back when you go back. Press Restore speaker layout to put everything back (also front A/B), or Discard speaker layout change to keep it and dismiss this notice. The restore point is lost when Home Assistant restarts or the integration reloads."
    },
    "speaker_layout_kept": {
      "title": "Some choices were left as you changed them",
      "description": "Restoring the speaker layout left {positions} alone, because they were changed after the layout was applied. Check them on the receiver."
    }
